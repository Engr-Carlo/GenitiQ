generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================
// Enums
// ========================================

enum UserRole {
  INSPECTOR
  OPERATOR
  ADMIN
}

enum MachineType {
  VMM
  CMM
}

enum MachineStatus {
  ACTIVE
  IDLE
  MAINTENANCE
  SHUTDOWN
}

enum PartStatus {
  PENDING
  OPERATOR_DONE
  RE_INSPECT
  COMPLETED
}

enum OperatorResult {
  ACCEPTED
  REJECTED
}

enum QADecision {
  APPROVED
  OVERRIDE_ACCEPT
  OVERRIDE_REJECT
  CONFIRMED_REJECT
  RE_INSPECT
  REWORK
  SCRAP
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ========================================
// Models
// ========================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  role       UserRole @default(INSPECTOR)
  department String?
  position   String?
  accountId  String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  uploadedParts    PartReference[]   @relation("PartReferenceUploader")
  operatedParts    PartReference[]   @relation("OperatorPartReferences")
  reviewedParts    PartReference[]   @relation("QAReviewerPartReferences")
  assignedParts    PartReference[]   @relation("InspectorPartReferences")
  machineSessions  MachineSession[]  @relation("OperatorSessions")
  machineReports   MachineReport[]
  shutdownEvents   ShutdownEvent[]
  auditLogs        AuditLog[]
  gaConfigUpdates  GAConfiguration[] @relation("GAConfigUpdater")
  assignedMachines Machine[]         @relation("MachineInspector")

  @@index([email])
  @@index([role])
  @@index([accountId])
}

model Machine {
  id                  String        @id @default(cuid())
  name                String        @unique
  type                MachineType
  status              MachineStatus @default(ACTIVE)
  location            String?
  specifications      Json?
  currentSessionId    String?
  assignedInspectorId String?
  assignedInspector   User?         @relation("MachineInspector", fields: [assignedInspectorId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  partReferences PartReference[]  @relation("MachinePartReferences")
  machineReports MachineReport[]
  shutdownEvents ShutdownEvent[]
  sessions       MachineSession[]

  @@index([status])
  @@index([type])
  @@index([assignedInspectorId])
}

model PartReference {
  id            String  @id @default(cuid())
  partNumber    String
  barcode       String  @unique
  estimatedTime Int
  deadline      DateTime
  quantity      Int     @default(1)
  position      Int     @default(0)
  priority      String?

  machineId   String?
  machine     Machine? @relation("MachinePartReferences", fields: [machineId], references: [id])
  inspectorId String?
  inspector   User?    @relation("InspectorPartReferences", fields: [inspectorId], references: [id])
  uploadedById String
  uploadedBy   User    @relation("PartReferenceUploader", fields: [uploadedById], references: [id])

  status PartStatus @default(PENDING)

  operatorId         String?
  operator           User?           @relation("OperatorPartReferences", fields: [operatorId], references: [id])
  operatorTimeIn     DateTime?
  operatorTimeOut    DateTime?
  operatorActualTime Int?
  operatorResult     OperatorResult?
  operatorNotes      String?
  machineSessionId   String?
  machineSession     MachineSession? @relation(fields: [machineSessionId], references: [id])

  qaReviewerId        String?
  qaReviewer          User?       @relation("QAReviewerPartReferences", fields: [qaReviewerId], references: [id])
  qaDecision          QADecision?
  qaJustification     String?
  qaReviewedAt        DateTime?
  inspectorTimeIn     DateTime?
  inspectorTimeOut    DateTime?
  inspectorActualTime Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partNumber])
  @@index([barcode])
  @@index([deadline])
  @@index([machineId])
  @@index([status])
  @@index([operatorId])
  @@index([qaReviewerId])
  @@index([machineSessionId])
  @@index([inspectorId])
}

model MachineSession {
  id             String        @id @default(cuid())
  machineId      String
  machine        Machine       @relation(fields: [machineId], references: [id])
  operatorId     String
  operator       User          @relation("OperatorSessions", fields: [operatorId], references: [id])
  startTime      DateTime      @default(now())
  endTime        DateTime?
  status         SessionStatus @default(ACTIVE)
  itemsCompleted Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  partReferences PartReference[]

  @@index([machineId])
  @@index([operatorId])
  @@index([status])
  @@index([startTime])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model MachineReport {
  id           String   @id @default(cuid())
  machineId    String
  machine      Machine  @relation(fields: [machineId], references: [id])
  reportedById String
  reportedBy   User     @relation(fields: [reportedById], references: [id])
  reason       String
  status       String   @default("Pending")
  createdAt    DateTime @default(now())

  @@index([machineId])
  @@index([createdAt])
}

model ShutdownEvent {
  id            String    @id @default(cuid())
  machineId     String
  machine       Machine   @relation(fields: [machineId], references: [id])
  reason        String
  initiatedById String
  initiatedBy   User      @relation(fields: [initiatedById], references: [id])
  startTime     DateTime  @default(now())
  endTime       DateTime?

  @@index([machineId])
  @@index([startTime])
}

model GAConfiguration {
  id                String   @id @default(cuid())
  populationSize    Int      @default(50)
  generations       Int      @default(100)
  crossoverRate     Float    @default(0.8)
  mutationRate      Float    @default(0.15)
  elitismCount      Int      @default(2)
  waitTimeWeight    Float    @default(0.4)
  utilizationWeight Float    @default(0.3)
  priorityWeight    Float    @default(0.3)
  isActive          Boolean  @default(true)
  updatedById       String?
  updatedBy         User?    @relation("GAConfigUpdater", fields: [updatedById], references: [id])
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}
