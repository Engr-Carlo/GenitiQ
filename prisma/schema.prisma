generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================
// Enums
// ========================================

enum UserRole {
  INSPECTOR
  OPERATOR
  ADMIN
}

enum MachineType {
  VMM
  CMM
}

enum MachineStatus {
  ACTIVE
  IDLE
  MAINTENANCE
  SHUTDOWN
}

enum InspectionResult {
  ACCEPTED
  REJECTED
}

enum QADecision {
  APPROVED
  OVERRIDE_ACCEPT
  OVERRIDE_REJECT
  RE_INSPECT
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ========================================
// Models
// ========================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  role       UserRole @default(INSPECTOR)
  department String?
  position   String?
  accountId  String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inspections        Inspection[]       @relation("InspectorInspections")
  qaReviews          Inspection[]       @relation("QAReviewerInspections")
  machineReports     MachineReport[]
  shutdownEvents     ShutdownEvent[]
  auditLogs          AuditLog[]
  gaConfigUpdates    GAConfiguration[]  @relation("GAConfigUpdater")
  machineSessions    MachineSession[]   @relation("OperatorSessions")
  partReferences     PartReference[]    @relation("PartReferenceUploader")
  scannedReferences  PartReference[]    @relation("ScannedPartReferences")
  inspectorReferences PartReference[]   @relation("InspectorPartReferences")
  assignedMachines   Machine[]          @relation("MachineInspector")

  @@index([email])
  @@index([role])
  @@index([accountId])
}

model Machine {
  id               String        @id @default(cuid())
  name             String        @unique
  type             MachineType
  status           MachineStatus @default(ACTIVE)
  location         String?
  specifications      Json?
  currentSessionId    String?
  assignedInspectorId String?
  assignedInspector   User?         @relation("MachineInspector", fields: [assignedInspectorId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  inspections      Inspection[]
  machineReports   MachineReport[]
  shutdownEvents   ShutdownEvent[]
  sessions         MachineSession[]
  partReferences   PartReference[]    @relation("MachinePartReferences")

  @@index([status])
  @@index([type])
  @@index([assignedInspectorId])
}

model PartReference {
  id            String   @id @default(cuid())
  partNumber    String
  barcode       String   @unique
  estimatedTime Int      // in minutes
  deadline      DateTime
  quantity      Int      @default(1)
  machineId     String?
  machine       Machine? @relation("MachinePartReferences", fields: [machineId], references: [id])
  inspectorId   String?
  inspector     User?    @relation("InspectorPartReferences", fields: [inspectorId], references: [id])
  uploadedById  String
  uploadedBy    User     @relation("PartReferenceUploader", fields: [uploadedById], references: [id])
  
  // Scanning tracking
  isScanned     Boolean  @default(false)
  scannedAt     DateTime?
  scannedById   String?
  scannedByOperator User? @relation("ScannedPartReferences", fields: [scannedById], references: [id])
  inspectionId  String?   @unique
  inspection    Inspection? @relation(fields: [inspectionId], references: [id])
  position      Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([partNumber])
  @@index([barcode])
  @@index([deadline])
  @@index([machineId])
  @@index([isScanned])
  @@index([inspectionId])
}

model MachineSession {
  id          String        @id @default(cuid())
  machineId   String
  machine     Machine       @relation(fields: [machineId], references: [id])
  operatorId  String
  operator    User          @relation("OperatorSessions", fields: [operatorId], references: [id])
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      SessionStatus @default(ACTIVE)
  itemsCompleted Int        @default(0)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  inspections Inspection[]

  @@index([machineId])
  @@index([operatorId])
  @@index([status])
  @@index([startTime])
}

model Inspection {
  id                    String            @id @default(cuid())
  partReference         PartReference?
  inspectorId           String
  inspector             User              @relation("InspectorInspections", fields: [inspectorId], references: [id])
  machineId             String
  machine               Machine           @relation(fields: [machineId], references: [id])
  result                InspectionResult
  measurements          Json?
  notes                 String?
  // Operator timing (first line of defense)
  operatorStartedAt     DateTime?
  operatorCompletedAt   DateTime?
  operatorActualTime    Int?
  scannedBarcode        String?
  // QA/Inspector review (second line of defense)
  qaReviewerId          String?
  qaReviewer            User?             @relation("QAReviewerInspections", fields: [qaReviewerId], references: [id])
  qaDecision            QADecision?
  qaJustification       String?
  qaReviewedAt          DateTime?
  inspectionStartedAt   DateTime?
  inspectionCompletedAt DateTime?
  inspectionActualTime  Int?
  // Session tracking
  machineSessionId      String?
  machineSession        MachineSession?   @relation(fields: [machineSessionId], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([inspectorId])
  @@index([machineId])
  @@index([result])
  @@index([createdAt])
  @@index([machineSessionId])
}


model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model MachineReport {
  id           String   @id @default(cuid())
  machineId    String
  machine      Machine  @relation(fields: [machineId], references: [id])
  reportedById String
  reportedBy   User     @relation(fields: [reportedById], references: [id])
  reason       String
  status       String   @default("Pending")
  createdAt    DateTime @default(now())

  @@index([machineId])
  @@index([createdAt])
}

model ShutdownEvent {
  id            String    @id @default(cuid())
  machineId     String
  machine       Machine   @relation(fields: [machineId], references: [id])
  reason        String
  initiatedById String
  initiatedBy   User      @relation(fields: [initiatedById], references: [id])
  startTime     DateTime  @default(now())
  endTime       DateTime?

  @@index([machineId])
  @@index([startTime])
}

model GAConfiguration {
  id                String   @id @default(cuid())
  populationSize    Int      @default(50)
  generations       Int      @default(100)
  crossoverRate     Float    @default(0.8)
  mutationRate      Float    @default(0.15)
  elitismCount      Int      @default(2)
  waitTimeWeight    Float    @default(0.4)
  utilizationWeight Float    @default(0.3)
  priorityWeight    Float    @default(0.3)
  isActive          Boolean  @default(true)
  updatedById       String?
  updatedBy         User?    @relation("GAConfigUpdater", fields: [updatedById], references: [id])
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}
